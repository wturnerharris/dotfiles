" ~/.vimrc: symlinked from the dotfiles repo.
" Plugins are managed by vim-plug and live in ~/.vim/plugged (outside the repo).

"
" PLUGINS
"
" fzf comes from Homebrew when it's installed there
let s:brew_fzf = ''
for s:dir in ['/opt/homebrew/opt/fzf', '/usr/local/opt/fzf']
  if isdirectory(s:dir)
    let s:brew_fzf = s:dir
    break
  endif
endfor

if filereadable(expand('~/.vim/autoload/plug.vim'))
  call plug#begin('~/.vim/plugged')
  if empty(s:brew_fzf)
    " No Homebrew fzf (e.g. Intel Macs without a prebuilt package): vim-plug
    " downloads fzf's prebuilt binary into ~/.vim/plugged/fzf/bin instead.
    " shell/env.sh puts that on PATH so the shell gets Ctrl-R too.
    Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
  endif
  Plug 'joshdick/onedark.vim'
  Plug 'vim-airline/vim-airline'
  Plug 'tpope/vim-fugitive'
  Plug 'tpope/vim-surround'
  Plug 'tpope/vim-commentary'
  Plug 'Raimondi/delimitMate'
  Plug 'mhinz/vim-grepper'
  Plug 'junegunn/fzf.vim'
  Plug 'tpope/vim-liquid'
  Plug 'mustache/vim-mustache-handlebars'
  call plug#end()
endif

if !empty(s:brew_fzf)
  execute 'set runtimepath+=' . s:brew_fzf
endif

"
" LEADER
"
let mapleader=","

"
" BASIC
"
set nocompatible
" Line numbers
set number
set relativenumber
" Allow backspace in insert mode
set backspace=indent,eol,start
set history=1000
set undolevels=1000
set undoreload=1000
" Show incomplete commands at the bottom
set showcmd
" No cursor blink
set gcr=a:blinkon0
" No sounds
set visualbell
set noerrorbells
" Reload files changed outside vim
set autoread
" Indentation: 2 spaces
set autoindent
set smartindent
set smarttab
set shiftwidth=2
set softtabstop=2
set tabstop=2
set expandtab
" Word wrap without inserting line breaks
set wrap
set linebreak
" Search
set hlsearch
set incsearch
" Clear search highlight by double tapping /
nmap <silent> // :nohlsearch<CR>
set ruler
set encoding=utf-8
set laststatus=2
" Persistent undo, kept outside the repo
if has('persistent_undo')
  let s:undodir = expand('~/.vim/undodir')
  if !isdirectory(s:undodir)
    call mkdir(s:undodir, 'p', 0700)
  endif
  let &undodir = s:undodir
  set undofile
endif
" Buffers can stay open in the background
set hidden
" No swap or backup files
set noswapfile
set nobackup
set nowritebackup
" Filetype detection, plugins and indent rules
filetype plugin indent on
" Show tabs and trailing spaces
set list listchars=tab:\ \ ,trail:·
" Fold on indent, 3 levels deep, open by default
set foldmethod=indent
set foldnestmax=3
set nofoldenable
" Scroll margins
set scrolloff=8
set sidescrolloff=15
set sidescroll=1
" Short delay leaving insert mode
set timeoutlen=1000 ttimeoutlen=0
" Pasting over a selection doesn't overwrite the clipboard
vnoremap p "_dP
" Use the system clipboard
set clipboard=unnamed

"
" APPEARANCE
"
syntax enable
set background=dark
set noshowmode
let g:enable_bold_font = 1
if has('termguicolors') && $COLORTERM =~# 'truecolor\|24bit'
  set termguicolors
endif
silent! colorscheme onedark

"
" COMPLETION (built in: Ctrl-N / Ctrl-P in insert mode)
"
set completeopt=menuone,noselect
set wildmenu
set wildmode=list:longest
set wildignore=*.o,*.obj,*~
set wildignore+=*sass-cache*
set wildignore+=*DS_Store*
set wildignore+=vendor/cache/**
set wildignore+=*.gem
set wildignore+=log/**
set wildignore+=tmp/**
set wildignore+=*.png,*.jpg,*.gif

"
" MOVEMENT
"
" 0 goes to the first non-blank character
nnoremap 0 ^
" Enter in normal mode adds a line below without entering insert mode
nmap <CR> o<Esc>
nmap <S-Enter> O<Esc>
" vv vertical split, ss horizontal split
nnoremap <silent> vv <C-w>v
nnoremap <silent> ss <C-w>s
" Split navigation
nnoremap <C-J> <C-W><C-J>
nnoremap <C-K> <C-W><C-K>
nnoremap <C-L> <C-W><C-L>
nnoremap <C-H> <C-W><C-H>
" Tabs
nnoremap th :tabfirst<CR>
nnoremap tj :tabnext<CR>
nnoremap tk :tabprev<CR>
nnoremap tl :tablast<CR>
nnoremap tn :tabnew<CR>
nnoremap tm :tabm<CR>

"
" PLUGIN SETTINGS
"
" fzf (replaces CtrlP; same ,js ,jd ,jr keys)
nnoremap ,js :Files src<CR>
nnoremap ,jd :Files dist<CR>
nnoremap ,jr :Files<CR>
nnoremap <leader>ff :Files<CR>
nnoremap <leader>fg :GitFiles<CR>
nnoremap <leader>fb :Buffers<CR>
nnoremap <leader>fl :Lines<CR>
let g:fzf_buffers_jump = 1

" delimitMate: Enter or space inside brackets expands them
let delimitMate_expand_cr = 1
let delimitMate_expand_space = 1

" vim-grepper: ,fi searches the repo (mnemonic: find in files)
nnoremap <leader>fi :Grepper -noquickfix -open -switch -tool git<CR>

"
" UTILS
"
" rr reloads this file
nnoremap rr :source $MYVIMRC<CR>
